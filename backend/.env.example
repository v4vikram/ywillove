NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=uwillove
DB_USER=root
DB_PASSWORD=
# Managed MySQL (Aiven/RDS) ke liye true. Local ke liye false
DB_SSL=false
# Production mein zaroori jab DB_SSL=true ho (Aiven se ca.pem download karke path do)
# Aiven ka ca.pem — Render/Vercel pe PEM ka poora text yahan paste karo
DB_SSL_CA=
# VPS ke liye: file ka path (DB_SSL_CA ke bajaye)
DB_SSL_CA_PATH=

JWT_ACCESS_SECRET=dev_dummy_access_secret_change_me
JWT_REFRESH_SECRET=dev_dummy_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# DUMMY — replace with Test Mode keys from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# DUMMY — replace after Qikink account approval (qikink.com)
QIKINK_CLIENT_ID=dummy_client_id
QIKINK_ACCESS_TOKEN=dummy_access_token
QIKINK_BASE_URL=https://sandbox.qikink.com/api

# DUMMY — replace with Cloudinary free-tier creds (cloudinary.com)
CLOUDINARY_CLOUD_NAME=dummy_cloud
CLOUDINARY_API_KEY=dummy_key
CLOUDINARY_API_SECRET=dummy_secret
